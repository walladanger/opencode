{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/agui-adapter",
  "version": "2.2.5",
  "private": true,
  "description": "Translate the OpenCode event stream into AG-UI server-sent events",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opencode-agui": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun ./src/cli.ts",
    "test": "bun test --timeout 10000",
    "typecheck": "bun check --no-script && bun check --no-script -p test/tsconfig.json",
    "typecheck:tsc": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.3",
    "@effect/platform-node": "catalog:",
    "@opencode/client": "workspace:*",
    "@opencode/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
